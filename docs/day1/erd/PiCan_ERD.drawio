<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-07-29T00:00:00.000Z" agent="Codex" version="26.0.9" type="device" compressed="false"><diagram id="pican-conceptual" name="1 - Conceptual ERD"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c-title" value="PiCan - Conceptual ERD (Chen notation)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=14;align=center;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2080" height="40" as="geometry"/></mxCell><mxCell id="c-legend" value="&lt;b&gt;Legend:&lt;/b&gt; rectangle = entity set; diamond = relationship set; underlined attribute = primary key; arrow points to the &lt;b&gt;one&lt;/b&gt; side; double line = total participation. &lt;br&gt;&lt;b&gt;Important:&lt;/b&gt; foreign keys are intentionally omitted from this conceptual page." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="50" y="70" width="1080" height="80" as="geometry"/></mxCell><mxCell id="profiles" value="&lt;div style=&quot;height:100%;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:bold;padding-bottom:6px;&quot;&gt;profiles&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #000;padding-top:6px;&quot;&gt;&lt;div&gt;&lt;u&gt;id&lt;/u&gt;&lt;/div&gt;&lt;div&gt;display_name&lt;/div&gt;&lt;div&gt;avatar_url&lt;/div&gt;&lt;div&gt;created_at&lt;/div&gt;&lt;div&gt;updated_at&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="70" y="560" width="250" height="190" as="geometry"/></mxCell><mxCell id="artworks" value="&lt;div style=&quot;height:100%;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:bold;padding-bottom:6px;&quot;&gt;artworks&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #000;padding-top:6px;&quot;&gt;&lt;div&gt;&lt;u&gt;id&lt;/u&gt;&lt;/div&gt;&lt;div&gt;title&lt;/div&gt;&lt;div&gt;image_url&lt;/div&gt;&lt;div&gt;thumbnail_url&lt;/div&gt;&lt;div&gt;image_width&lt;/div&gt;&lt;div&gt;image_height&lt;/div&gt;&lt;div&gt;created_at&lt;/div&gt;&lt;div&gt;updated_at&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="680" y="190" width="280" height="270" as="geometry"/></mxCell><mxCell id="canvases" value="&lt;div style=&quot;height:100%;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:bold;padding-bottom:6px;&quot;&gt;canvases&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #000;padding-top:6px;&quot;&gt;&lt;div&gt;&lt;u&gt;id&lt;/u&gt;&lt;/div&gt;&lt;div&gt;name&lt;/div&gt;&lt;div&gt;created_at&lt;/div&gt;&lt;div&gt;updated_at&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="680" y="930" width="280" height="180" as="geometry"/></mxCell><mxCell id="canvas_items" value="&lt;div style=&quot;height:100%;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:bold;padding-bottom:6px;&quot;&gt;canvas_items&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #000;padding-top:6px;&quot;&gt;&lt;div&gt;&lt;u&gt;id&lt;/u&gt;&lt;/div&gt;&lt;div&gt;x_position&lt;/div&gt;&lt;div&gt;y_position&lt;/div&gt;&lt;div&gt;item_w