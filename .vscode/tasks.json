{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: dev",
      "type": "shell",
      "command": "pnpm dev:frontend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "AI service: dev",
      "type": "shell",
      "command": "${workspaceFolder}/ai-service/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/ai-service"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}

